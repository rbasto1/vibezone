{
  "name": "@vibezone/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "cd ../../packages/assistant-ui && turbo build --filter='./packages/*' --filter='!@assistant-ui/react' && turbo build --filter='@assistant-ui/react'",
    "dev": "dotenvx run -- next dev --turbopack --port 3022",
    "build:assistant-ui": "pnpm run predev",
    "build": "pnpm run db:push && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier-fix": "prettier --write .",
    "db:push": "drizzle-kit push --verbose",
    "db:studio": "drizzle-kit studio",
    "db:seed": "dotenvx run -- tsx db/seed.ts",
    "set-vercel-envs": "dotenvx run -- tsx scripts/set-vercel-envs.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.12",
    "@ai-sdk/openai": "^2.0.24",
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/react-ai-sdk": "workspace:*",
    "@assistant-ui/react-markdown": "workspace:*",
    "@neondatabase/serverless": "^1.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.5.0",
    "@trpc/next": "^11.5.0",
    "@trpc/react-query": "^11.5.0",
    "@trpc/server": "^11.5.0",
    "ai": "^5.0.27",
    "assistant-cloud": "workspace:*",
    "better-auth": "^1.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "framer-motion": "^12.23.12",
    "jotai": "^2.13.1",
    "lucide-react": "^0.542.0",
    "next": "15.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.5.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.8",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
