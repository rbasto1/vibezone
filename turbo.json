{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build:assistant-ui": {
      "inputs": ["**/*.*", "!.next", "!.turbo"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"],
      "env": [
        "OPENAI_*",
        "ASSISTANT_*",
        "JWT_*",
        "ENTELLIGENCE_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "build": {
      "dependsOn": ["^build", "build:assistant-ui"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format": {
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_LLM_WORKER_URL",
    "NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "AUTH_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM"
  ]
}
