{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build:assistant-ui-1": {
      "dependsOn": ["^build:assistant-ui-1"],
      "inputs": ["**/*.*", "!.next", "!.turbo"],
      "outputs": ["dist", "generated/**"],
      "env": [
        "OPENAI_*",
        "ASSISTANT_*",
        "JWT_*",
        "ENTELLIGENCE_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "build:assistant-ui-2": {
      "dependsOn": ["build:assistant-ui-1"],
      "inputs": ["**/*.*", "!.next", "!.turbo"],
      "outputs": ["dist", "generated/**"],
      "env": [
        "OPENAI_*",
        "ASSISTANT_*",
        "JWT_*",
        "ENTELLIGENCE_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "build:assistant-ui-3": {
      "dependsOn": ["build:assistant-ui-2"],
      "inputs": ["**/*.*", "!.next", "!.turbo"],
      "outputs": ["dist", "generated/**"],
      "env": [
        "OPENAI_*",
        "ASSISTANT_*",
        "JWT_*",
        "ENTELLIGENCE_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "build": {
      "dependsOn": [
        "build:assistant-ui-1",
        "build:assistant-ui-2",
        "build:assistant-ui-3"
      ],
      "inputs": ["**/*.*", "!.next", "!.turbo"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_LLM_WORKER_URL",
        "NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "AUTH_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format": {
      "cache": false
    }
  }
}
