{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.dev.vars"],
  "tasks": {
    "@vibezone/web#build": {
      "inputs": ["**/*.*", "!.next", "!.turbo"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format": {
      "cache": false
    }
  },
  "globalEnv": [
    "AUTH_SECRET",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "NEXT_PUBLIC_*",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "OPENROUTER_API_KEY",
    "RESEND_API_KEY",
    "DEEPL_API_KEY",
    "MARITACAAI_API_KEY",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY"
  ]
}
