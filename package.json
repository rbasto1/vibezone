{
  "name": "@vibezone/monorepo",
  "private": true,
  "author": "Ricardo Basto <ricardo.basto@toptal.com>",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "cd apps/web && turbo run build",
    "deploy:llm-worker": "pnpm -F llm-worker deploy",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "auto-fix": "turbo run format --parallel",
    "db:push": "pnpm -F @vibezone/database run db:push",
    "db:studio": "pnpm -F @vibezone/database run db:studio"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils": "3.0.16",
      "@ai-sdk/react": "~2.0.89",
      "@types/react": "19.1.12",
      "ai": "5.0.89",
      "react": "19.1.1",
      "react-dom": "19.1.1"
    }
  },
  "devDependencies": {
    "@turbo/gen": "^2.5.6",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
