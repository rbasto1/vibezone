{
  "name": "@vibezone/monorepo",
  "private": true,
  "author": "Ricardo Basto <ricardo.basto@toptal.com>",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "cd apps/web && turbo run build",
    "deploy:llm-worker": "pnpm -F llm-worker deploy",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "auto-fix": "turbo run format --parallel",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "react": "19.1.1",
      "react-dom": "19.1.1",
      "@types/react": "19.1.12",
      "ai": "5.0.24",
      "@ai-sdk/provider-utils": "3.0.6",
      "assistant-cloud": "workspace:*"
    }
  },
  "devDependencies": {
    "@turbo/gen": "^2.5.6",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "wrangler": "^4.32.0"
  }
}
