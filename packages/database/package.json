{
  "name": "@vibezone/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./tables": {
      "types": "./src/tables.ts",
      "default": "./src/tables.ts"
    },
    "./relations": {
      "types": "./src/relations.ts",
      "default": "./src/relations.ts"
    },
    "./enums": {
      "types": "./src/enums.ts",
      "default": "./src/enums.ts"
    },
    "./helpers": {
      "types": "./src/helpers.ts",
      "default": "./src/helpers.ts"
    },
    "./json-columns-types": {
      "types": "./src/json-columns-types.ts",
      "default": "./src/json-columns-types.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "drizzle-orm": "^0.44.5"
  }
}
